{
  "name": "chordlog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "steiger": "steiger ./src --fail-on-warnings",
    "knip": "knip",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "browser": "agent-browser",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm steiger && pnpm knip",
    "verify": "pnpm check && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "agent-browser": "^0.44.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "steiger": "^0.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
